# Public - safe to expose to the browser
NEXT_PUBLIC_GOOGLE_ANALYTICS=G-440BZH4GCS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only - NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# CryptAPI requires no API key, only the wallet address that funds are
# forwarded to. Use a comma-separated list of ticker@address pairs.
# Example: BTC@1H6ZZ...,ETH@0xabc...,TRC20/USDT@TXYZ...
CRYPTAPI_ADDRESSES=

# Optional: Solana RPC key used by free tools / balance display
SOLANA_RPC_URL=

# Contact webhook that receives paid-order notifications
ORDER_NOTIFY_WEBHOOK_URL=